# No server API keys are required.
# Users bring their own keys in the browser (BYOK). LLM costs are billed to them.

# Optional server flags:
# DISABLE_PYTHON=1          # Disable server Python tool (browser Pyodide is preferred)
# CORS_ORIGINS=https://app.example.com   # Extra frontend origins allowed to call /api/* (comma-separated; same-origin by default)
# NODE_ENV=production
